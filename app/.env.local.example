# MairiMichi 環境変数
#
# ★実行時に外部APIを叩かない設計なので、アプリ本体には資格情報が要らない。
#   以下は ETL でのみ使う。

# 公共交通オープンデータセンター（ODPT）
# 京都市営バスのGTFSは gtfs-data.jp に無く ODPT にしかないため、
# 京都を扱うなら必須。ユーザ登録は無料。
ODPT_CONSUMER_KEY=

# Wikimedia API / ダンプ取得時の User-Agent（連絡先を含む固有UAが必須）
# 汎用UAだとレート制限の対象になる
WIKIMEDIA_USER_AGENT="mairimichi/0.1 (https://github.com/zephel01/MairiMichi; contact@example.com)"

# 自前 Valhalla（Phase 2 以降。Phase 1 は公開インスタンスを低速で使う）
VALHALLA_BASE_URL=http://localhost:8002
